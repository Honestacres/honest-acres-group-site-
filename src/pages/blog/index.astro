---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<BaseLayout
  title="Blog"
  description="Plainspoken Texas land education from Honest Acres Group: counties, water, ag valuation, wildlife, and buying and selling farm, ranch, and recreational land."
>
  <section class="section">
    <div class="container">
      <h1>From the land — the Honest Acres blog</h1>
      <p>New posts every few days: Texas land, county by county, explained the way we'd explain it across a tailgate.</p>

      {posts.map((post) => (
        <article>
          <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
          <p class="meta">
            {post.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            {post.data.tags.length > 0 && <> · {post.data.tags.join(' · ')}</>}
          </p>
          <p>{post.data.description}</p>
        </article>
      ))}

      {posts.length === 0 && <p>First posts are on the way — check back soon.</p>}
    </div>
  </section>
</BaseLayout>
